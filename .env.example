# Copia este archivo como .env y completa los valores. El .env es obligatorio:
# sin él la app no arranca (src/config/load-env.ts). Nunca subas el .env.

# --- Base de datos (PostgreSQL) ---
DB_CONTAINER_NAME=riwi-tv-db
POSTGRES_USER=riwi_tv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=riwi_tv
# Con Docker Compose el host es el servicio "db". Para correr la app fuera de
# Docker (npm run start:dev) usa POSTGRES_HOST=localhost y POSTGRES_PORT=5433.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Puerto de Postgres expuesto en tu máquina.
POSTGRES_HOST_PORT=5433

# --- Aplicación ---
APP_CONTAINER_NAME=riwi-tv-api
APP_PORT=5001
# development | qa | production
NODE_ENV=development
# Zona horaria: define "hoy" y los 7 días de la cartelera (HU-003).
TZ=America/Bogota
# debug | info | warn | error
LOG_LEVEL=info
# Orígenes permitidos separados por coma. Vacío = cualquier origen.
CORS_ORIGIN=http://localhost:3000

# --- Autenticación (HU-006, HU-007) ---
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Deben ser distintos entre sí.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10
MAX_FAILED_ATTEMPTS=5
# Vigencia del enlace de restablecimiento de contraseña (HU-007): 30m, 1h, 1d…
RESET_TOKEN_EXPIRES_IN=1h

# --- Correo (HU-006) ---
# Vacío = correo emulado: no sale a la red, solo se registra en el log (proyecto educativo).
# Para enviar de verdad, define el servidor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RiwiTV <no-reply@riwitv.local>
# URL del frontend: el correo de activación enlaza a ${FRONTEND_URL}/verify-email?token=...
FRONTEND_URL=http://localhost:3000

# --- Sillas (HU-010) ---
# Minutos que una silla queda bloqueada (RN-040); por defecto 10.
SEAT_LOCK_MINUTES=10
# Máximo de sillas por función cuando la función no define el suyo; por defecto 8.
MAX_SEATS_PER_RESERVATION=8

# --- Observabilidad (@nestjs/observe) ---
OBSERVER_APP_KEY=change-me
OBSERVE_APP_SECRET=change-me

# --- Límites de recursos de Docker ---
DB_CPU_LIMIT=1
DB_MEM_LIMIT=512M
APP_CPU_LIMIT=1
APP_MEM_LIMIT=512M
